generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hero {
  id          Int      @id @default(1)
  badgeText   String
  headline    String
  subheadline String
  updatedAt   DateTime @updatedAt
}
